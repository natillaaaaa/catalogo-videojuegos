# Copia este archivo como .env (NO subas el .env al repositorio ni al zip).
# En Netlify estas mismas variables se crean en:
#   Site configuration -> Environment variables

# Redis Cloud -> tu base de datos -> Connect -> "Redis CLI" / URL pública
# Formato: redis://default:<contraseña>@<host>:<puerto>
REDIS_URL=redis://default:CAMBIAR@redis-00000.c000.us-east-1-0.ec2.redns.redis-cloud.com:00000

# Clave larga y aleatoria para firmar los JWT. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Duración del token (opcional). Ejemplos: 15m, 2h, 1d
JWT_EXPIRA=2h

# Sólo para "npm run seed" (opcional): crea un usuario administrador.
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@catalogo.com
ADMIN_CLAVE=CAMBIAR_CLAVE_ADMIN
